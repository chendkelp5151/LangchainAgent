# NVIDIA NIM API Key (Get yours at https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# Model Selection:
# Nemotron 3 Ultra (550B MoE flagship reasoning & orchestration model):
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Alternative Nemotron models on NVIDIA NIM:
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
# NVIDIA_MODEL=nvidia/nemotron-mini-4b-instruct

# Model Parameters
TEMPERATURE=0.7
MAX_TOKENS=2048
